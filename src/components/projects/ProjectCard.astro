---
import type { CollectionEntry } from 'astro:content';

type Props = {
  entry: CollectionEntry<'projects'>;
};

const { entry } = Astro.props;
---

<article class="border-b border-border py-8">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h2 class="font-heading text-lg font-semibold leading-tight">
      <a class="text-primary no-underline hover:text-ocean" href={`/projects/${entry.data.permalink}`}>
        {entry.data.title}
      </a>
    </h2>
    <span class="metadata">{entry.data.status}</span>
  </div>
  <p class="mt-3 max-w-prose text-secondary">{entry.data.summary}</p>
  <p class="mt-4 font-mono text-xs text-secondary opacity-60">
    {entry.data.technologies.join(' · ')}
  </p>
</article>
