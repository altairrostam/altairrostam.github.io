---
interface Props {
  active?: "writing" | "work" | "resume" | "about";
  home?: boolean;
}

const { active, home = false } = Astro.props;
const navClass = home ? "nav" : "nav page-nav";
---

<nav class={navClass} aria-label="Primary navigation">
  <a class="brand" href="/index.html" aria-label="Altair R. home">
    <span class="brand-mark" aria-hidden="true"><span></span></span>
    <span>altair r.</span>
  </a>
  <div class="nav-links">
    <a href="/writing.html" aria-current={active === "writing" ? "page" : undefined}>writing</a>
    <a href="/work.html" aria-current={active === "work" ? "page" : undefined}>work</a>
    <a href="/resume.html" aria-current={active === "resume" ? "page" : undefined}>resume</a>
    <a href="/about.html" aria-current={active === "about" ? "page" : undefined}>about</a>
    <button class="theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
      <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path>
      </svg>
      <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path>
      </svg>
    </button>
  </div>
</nav>
