---
import Nav from "./Nav.astro";

interface Props {
  active?: "writing" | "work" | "resume" | "about";
}

const { active } = Astro.props;
---

<header class="site-header" id="site-header">
  <Nav active={active} />
</header>
<div class="page-band" aria-hidden="true">
  <div class="city-band">
    <span class="city-frame is-active" style="background-image: url('/assets/city/golden.png')"></span>
    <span class="city-tint"></span>
    <span class="city-scrim"></span>
    <span class="city-fade"></span>
  </div>
</div>
