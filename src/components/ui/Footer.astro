---
import { contactLinks } from '@/data/contact';
---

<footer class="border-t border-border">
  <div class="content-shell flex flex-col gap-5 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="metadata">© {new Date().getFullYear()} Altair Rostam</p>
    <nav class="flex items-center gap-2" aria-label="Contact links">
      {
        contactLinks.map(({ href, label, icon: Icon }) => (
          <a
            class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border text-secondary transition hover:border-ocean hover:text-ocean"
            href={href}
            aria-label={label}
          >
            <Icon size={17} stroke-width={1.8} />
          </a>
        ))
      }
    </nav>
  </div>
</footer>
