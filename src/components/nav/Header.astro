---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const pathname = Astro.url.pathname;
---

<header class="border-b border-border/80 bg-bg/95">
  <div class="content-shell flex min-h-16 items-center justify-between gap-6 py-3">
    <a
      class="nav-home group relative flex h-9 w-9 items-center justify-center rounded-md text-secondary no-underline transition-colors hover:text-primary"
      href="/"
      aria-label="Home"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="nav-home-icon h-[1.125rem] w-[1.125rem] transition-transform duration-300 group-hover:scale-110"
        aria-hidden="true"
      >
        <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
        <path d="M9 21V12h6v9"/>
      </svg>
      <span class="nav-home-halo" aria-hidden="true"></span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {
        navItems.map((item) => {
          const isActive = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
          return (
            <a
              class:list={[
                'nav-link relative rounded-md px-3 py-2 font-mono text-[0.8125rem] no-underline transition',
                isActive ? 'nav-link--active text-primary' : 'text-secondary hover:text-primary',
              ]}
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        class="hidden font-mono text-[0.75rem] text-secondary no-underline opacity-60 hover:opacity-100 md:inline"
        href="/resume"
      >
        résumé ↗
      </a>
      <ThemeToggle />
      <!-- Hamburger — animates to × when open -->
      <button
        class="mobile-nav-toggle relative inline-flex h-10 w-10 items-center justify-center rounded-md border border-border text-primary transition-colors hover:border-ocean hover:text-ocean md:hidden"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        data-mobile-nav-toggle
      >
        <span class="mobile-bar mobile-bar-top"></span>
        <span class="mobile-bar mobile-bar-mid"></span>
        <span class="mobile-bar mobile-bar-bot"></span>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div
    class="mobile-nav-panel md:hidden"
    data-mobile-nav
    aria-hidden="true"
  >
    <nav class="content-shell py-5" aria-label="Mobile navigation">
      <div class="grid gap-1">
        {
          navItems.map((item) => {
            const isActive = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
            return (
              <a
                class:list={[
                  'mobile-nav-link rounded-md px-3 py-3 font-mono text-sm no-underline transition-colors',
                  isActive ? 'text-primary mobile-nav-link--active' : 'text-secondary hover:text-primary',
                ]}
                href={item.href}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>
      <div class="mt-5 border-t border-border pt-4">
        <a
          class="font-mono text-xs text-secondary no-underline opacity-60 hover:opacity-100"
          href="/resume"
        >
          résumé ↗
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Hamburger bars */
  .mobile-bar {
    position: absolute;
    left: 50%;
    width: 1rem;
    height: 1px;
    background: currentColor;
    transform: translateX(-50%);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .mobile-bar-top { transform: translateX(-50%) translateY(-5px); }
  .mobile-bar-mid { transform: translateX(-50%) translateY(0); }
  .mobile-bar-bot { transform: translateX(-50%) translateY(5px); }

  /* Open state — becomes × */
  [aria-expanded="true"] .mobile-bar-top {
    transform: translateX(-50%) rotate(45deg);
  }
  [aria-expanded="true"] .mobile-bar-mid {
    opacity: 0;
    transform: translateX(-50%) scaleX(0);
  }
  [aria-expanded="true"] .mobile-bar-bot {
    transform: translateX(-50%) rotate(-45deg);
  }

  /* Mobile panel */
  .mobile-nav-panel {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    border-bottom: 1px solid transparent;
    transition: max-height 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.22s ease,
                border-color 0.22s ease;
  }
  .mobile-nav-panel.is-open {
    max-height: 16rem;
    opacity: 1;
    border-bottom-color: var(--border);
  }

  /* Active link: left accent bar */
  .mobile-nav-link--active {
    position: relative;
    padding-left: 1.25rem;
  }
  .mobile-nav-link--active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 1rem;
    background: var(--accent-ocean);
    border-radius: 999px;
  }
</style>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  navToggle?.addEventListener('click', () => {
    const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!isOpen));
    mobileNav?.classList.toggle('is-open', !isOpen);
    mobileNav?.setAttribute('aria-hidden', String(isOpen));
  });
</script>
