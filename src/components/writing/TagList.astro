---
type Props = {
  tags: string[];
};

const { tags } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label="Tags">
  {
    tags.map((tag) => (
      <li>
        <span class="rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-xs text-nature">
          {tag}
        </span>
      </li>
    ))
  }
</ul>
