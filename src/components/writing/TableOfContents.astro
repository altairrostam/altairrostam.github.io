---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
};

const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  visibleHeadings.length > 0 && (
    <aside class="rounded-lg border border-border bg-surface p-5">
      <h2 class="font-mono text-sm font-medium text-primary">Contents</h2>
      <ol class="mt-4 grid gap-2">
        {visibleHeadings.map((heading) => (
          <li class:list={[heading.depth === 3 && 'pl-4']}>
            <a
              class="toc-link font-mono text-sm text-secondary no-underline transition-colors duration-150 hover:text-ocean"
              href={`#${heading.slug}`}
              data-heading={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </aside>
  )
}

<style>
  .toc-link[data-active] {
    color: var(--accent-ocean);
    font-weight: 500;
  }
</style>

<script>
  function initToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-heading]');
    if (!links.length) return;

    const slugs = Array.from(links).map((l) => l.dataset.heading!);
    const headingEls = slugs
      .map((slug) => document.getElementById(slug))
      .filter(Boolean) as HTMLElement[];

    if (!headingEls.length) return;

    let activeSlug = '';

    const setActive = (slug: string) => {
      if (slug === activeSlug) return;
      activeSlug = slug;
      links.forEach((link) => {
        if (link.dataset.heading === slug) {
          link.setAttribute('data-active', '');
        } else {
          link.removeAttribute('data-active');
        }
      });
    };

    // IntersectionObserver: fire when heading enters the top 20% of the viewport
    const observer = new IntersectionObserver(
      (entries) => {
        // Find the topmost visible heading
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length) {
          setActive((visible[0].target as HTMLElement).id);
          return;
        }

        // If nothing intersects, find the last heading above the fold
        const scrollY = window.scrollY;
        let best: HTMLElement | null = null;
        for (const el of headingEls) {
          if (el.offsetTop <= scrollY + window.innerHeight * 0.25) {
            best = el;
          }
        }
        if (best) setActive(best.id);
      },
      {
        rootMargin: '-10% 0px -75% 0px',
        threshold: 0,
      },
    );

    headingEls.forEach((el) => observer.observe(el));

    // Set initial active on page load
    const firstVisible = headingEls.find((el) => el.offsetTop >= window.scrollY);
    if (firstVisible) setActive(firstVisible.id);
    else if (headingEls.length) setActive(headingEls[headingEls.length - 1].id);
  }

  // Run immediately (no ViewTransitions, so DOMContentLoaded is fine)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToc);
  } else {
    initToc();
  }
</script>
