---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/formatDate';
import TagList from './TagList.astro';

type Props = {
  entry: CollectionEntry<'writing'>;
};

const { entry } = Astro.props;
---

<article class="article-card">
  <p class="metadata">{formatDate(entry.data.publishDate)}</p>
  <h2 class="mt-3 font-heading text-lg font-semibold leading-tight">
    <a class="article-title text-primary no-underline transition-colors duration-200" href={`/writing/${entry.data.permalink}`}>
      {entry.data.title}
    </a>
  </h2>
  <p class="mt-4 max-w-prose text-secondary">{entry.data.description}</p>
  <div class="mt-5">
    <TagList tags={entry.data.tags} />
  </div>
</article>
