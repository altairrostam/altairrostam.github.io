---
import type { CollectionEntry } from 'astro:content';
import JsonLdBlogPosting from '@/components/seo/JsonLdBlogPosting.astro';
import TableOfContents from '@/components/writing/TableOfContents.astro';
import TagList from '@/components/writing/TagList.astro';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '@/lib/formatDate';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  entry: CollectionEntry<'writing'>;
  headings: Heading[];
};

const { entry, headings } = Astro.props;
const modifiedDate = entry.data.updatedDate ?? entry.data.publishDate;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={`/writing/${entry.data.permalink}`}
  image={entry.data.coverImage}
  type="article"
>
  <JsonLdBlogPosting entry={entry} />
  <article class="content-shell py-14 sm:py-20">
    <header class="max-w-4xl">
      <p class="metadata">
        {formatDate(entry.data.publishDate)}
        {modifiedDate > entry.data.publishDate && ` / Updated ${formatDate(modifiedDate)}`}
      </p>
      <h1 class="mt-5 font-heading text-[clamp(3rem,8vw,6rem)] font-extrabold leading-none">
        {entry.data.title}
      </h1>
      <p class="mt-7 max-w-prose text-xl leading-8 text-secondary">{entry.data.description}</p>
      <div class="mt-7">
        <TagList tags={entry.data.tags} />
      </div>
    </header>

    <section class="mt-12 max-w-prose rounded-lg border border-border bg-surface p-6">
      <h2 class="font-mono text-sm font-medium text-warm">Executive Summary</h2>
      <p class="mt-3 text-lg leading-8 text-primary">{entry.data.executiveSummary}</p>
    </section>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,68ch)_280px] lg:items-start">
      <div class="prose-content">
        <slot />
      </div>
      <div class="lg:sticky lg:top-6">
        <TableOfContents headings={headings} />
      </div>
    </div>

    <section class="mt-14 max-w-prose rounded-lg border border-border bg-surface p-6">
      <h2 class="font-mono text-sm font-medium text-warm">Key Takeaways</h2>
      <ul class="mt-4 grid gap-3">
        {entry.data.keyTakeaways.map((takeaway) => <li class="leading-7 text-primary">{takeaway}</li>)}
      </ul>
    </section>

    {
      entry.data.faq.length > 0 && (
        <section class="mt-14 max-w-prose">
          <h2 class="font-heading text-3xl font-semibold">FAQ</h2>
          <div class="mt-5 grid gap-5">
            {entry.data.faq.map((item) => (
              <div class="border-t border-border pt-5">
                <h3 class="font-heading text-xl font-semibold">{item.question}</h3>
                <p class="mt-2 leading-7 text-secondary">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
