---
import type { CollectionEntry } from 'astro:content';
import JsonLdBlogPosting from '@/components/seo/JsonLdBlogPosting.astro';
import TableOfContents from '@/components/writing/TableOfContents.astro';
import TagList from '@/components/writing/TagList.astro';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '@/lib/formatDate';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  entry: CollectionEntry<'writing'>;
  headings: Heading[];
};

const { entry, headings } = Astro.props;
const modifiedDate = entry.data.updatedDate ?? entry.data.publishDate;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={`/writing/${entry.data.permalink}`}
  image={entry.data.coverImage}
  type="article"
>
  <JsonLdBlogPosting entry={entry} />
  <div
    id="reading-progress"
    class="fixed left-0 top-0 z-50 h-[3px] w-0 bg-ocean transition-none"
    aria-hidden="true"
  ></div>

  <article class="content-shell pt-14 pb-20">
    <header class="max-w-prose">
      <p class="metadata">
        {formatDate(entry.data.publishDate)}
        {modifiedDate > entry.data.publishDate && ` · Updated ${formatDate(modifiedDate)}`}
      </p>
      <h1 class="mt-4 font-heading text-3xl font-bold leading-tight">
        {entry.data.title}
      </h1>
      <p class="mt-4 leading-7 text-secondary">{entry.data.description}</p>
      <div class="mt-5">
        <TagList tags={entry.data.tags} />
      </div>
    </header>

    <div class="mt-2 max-w-prose border-l-2 border-warm pl-5 py-1">
      <p class="leading-7 text-secondary italic">{entry.data.executiveSummary}</p>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,68ch)_240px] lg:items-start">
      <div class="prose-content">
        <slot />
      </div>
      <div class="lg:sticky lg:top-6">
        <TableOfContents headings={headings} />
      </div>
    </div>

    <section class="mt-14 max-w-prose border-t border-border pt-8">
      <h2 class="font-mono text-xs font-medium uppercase tracking-widest text-secondary">Takeaways</h2>
      <ul class="mt-4 grid gap-2">
        {entry.data.keyTakeaways.map((takeaway) => (
          <li class="leading-7 text-secondary before:mr-2 before:content-['—']">{takeaway}</li>
        ))}
      </ul>
    </section>

    {
      entry.data.faq.length > 0 && (
        <section class="mt-10 max-w-prose border-t border-border pt-8">
          <h2 class="font-mono text-xs font-medium uppercase tracking-widest text-secondary">FAQ</h2>
          <div class="mt-6 grid gap-6">
            {entry.data.faq.map((item) => (
              <div>
                <h3 class="font-heading text-base font-semibold">{item.question}</h3>
                <p class="mt-2 leading-7 text-secondary">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>
<script>
  const bar = document.getElementById('reading-progress') as HTMLElement | null;
  if (bar) {
    const update = () => {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = total > 0 ? `${(window.scrollY / total) * 100}%` : '0%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

</BaseLayout>
