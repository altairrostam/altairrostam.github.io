---
import type { CollectionEntry } from 'astro:content';
import JsonLdCreativeWork from '@/components/seo/JsonLdCreativeWork.astro';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '@/lib/formatDate';

type Props = {
  entry: CollectionEntry<'projects'>;
};

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} canonical={`/projects/${entry.data.permalink}`}>
  <JsonLdCreativeWork entry={entry} />
  <article class="content-shell pt-14 pb-20">
    <header class="max-w-prose">
      <p class="metadata">{entry.data.status} · Updated {formatDate(entry.data.dateUpdated)}</p>
      <h1 class="mt-4 font-heading text-3xl font-bold leading-tight">
        {entry.data.title}
      </h1>
      <p class="mt-4 leading-7 text-secondary">{entry.data.summary}</p>
      <dl class="mt-7 flex flex-wrap gap-x-8 gap-y-3 border-t border-border pt-5">
        <div>
          <dt class="metadata">Role</dt>
          <dd class="mt-1 text-sm text-primary">{entry.data.role}</dd>
        </div>
        <div>
          <dt class="metadata">Started</dt>
          <dd class="mt-1 text-sm text-primary">{formatDate(entry.data.dateStarted)}</dd>
        </div>
        <div>
          <dt class="metadata">Updated</dt>
          <dd class="mt-1 text-sm text-primary">{formatDate(entry.data.dateUpdated)}</dd>
        </div>
      </dl>
      <p class="mt-5 font-mono text-xs text-secondary opacity-60">
        {entry.data.technologies.join(' · ')}
      </p>
    </header>
    <div class="prose-content mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>
