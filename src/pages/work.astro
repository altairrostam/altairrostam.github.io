---
import Layout from "../layouts/Layout.astro";
import HeaderBand from "../components/HeaderBand.astro";
import PageTitle from "../components/PageTitle.astro";
import { openSource, projects } from "../data/content";
---

<Layout title="Work | Altair R." description="Work history, projects, and open source notes from Altair R.">
  <HeaderBand active="work" />

  <main class="content-main">
    <header class="page-header">
      <PageTitle title="Work" icon="fortress" />
      <p>Selected tools and open-source work from the parts of systems I keep finding myself near.</p>
    </header>

    <section class="work-section" aria-labelledby="projects-title">
      <h2 class="mini-heading" id="projects-title">
        <span class="heading-icon icon-anvil" aria-hidden="true"></span>
        Projects
      </h2>
      <ol class="project-list">
        {projects.map((project) => (
          <li>
            <a class="project-row" href="#">
              <strong>{project.name}</strong>
              <span>{project.description}</span>
              <small>{project.meta}</small>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="work-section" aria-labelledby="open-source-title">
      <h2 class="mini-heading" id="open-source-title">
        <span class="heading-icon icon-grimoire" aria-hidden="true"></span>
        Open Source
      </h2>
      <ol class="project-list">
        {openSource.map((project) => (
          <li>
            <a class="project-row" href="#">
              <strong>{project.name}</strong>
              <span>{project.description}</span>
              <small>{project.meta}</small>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>
