---
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/writing/ArticleCard.astro';
import JsonLdPerson from '@/components/seo/JsonLdPerson.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const latestWriting = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Altair Rostam"
  description="Engineering notes, research writing, and project documentation from Altair Rostam."
>
  <JsonLdPerson />
  <section class="content-shell pt-14 pb-10">
    <h1 class="font-heading text-xl font-semibold">Altair Rostam</h1>
    <p class="mt-2 max-w-prose text-secondary">
      I build AI systems — retrieval pipelines, evaluation loops, automation boundaries — and write down what that actually takes.
    </p>
  </section>

  <section class="pb-14">
    <div class="content-shell">
      <div class="mt-2" data-stagger>
        {latestWriting.map((article) => <ArticleCard entry={article} />)}
      </div>
      <p class="mt-8">
        <a class="font-mono text-xs text-secondary no-underline opacity-60 hover:opacity-100" href="/writing">all writing →</a>
      </p>
    </div>
  </section>
</BaseLayout>
