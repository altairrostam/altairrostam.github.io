---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { latestWriting } from "../data/content";
---

<Layout
  title="Altair R. (Altair Rostam) — Senior Software Engineer"
  description="Senior software engineer portfolio of Altair R. (Altair Rostam), building full-stack systems, backend services, AI/ML applications, and cloud infrastructure."
  ogTitle="Altair R. (Altair Rostam) — Senior Software Engineer"
  ogDescription="Full-stack systems, AI/ML, cloud infrastructure, and browser automation."
  canonical="https://altairrostam.github.io/"
>
  <header class="site-header is-home-header" id="site-header">
    <Nav home />
  </header>

  <section class="home-hero" aria-labelledby="home-title">
    <div class="city-stage" aria-hidden="true">
      <span class="city-frame is-active" style="background-image: url('/assets/city/golden.webp')"></span>
      <span class="city-tint"></span>
      <span class="city-scrim"></span>
      <span class="city-fade"></span>
    </div>

    <div class="hero-content">
      <header class="hero-copy">
        <h1 id="home-title">Altair R.</h1>
        <p>Software engineer, roamer by role - I work on whatever is actually broken.</p>
      </header>
    </div>
  </section>

  <main class="home-main">
    <section class="latest-notes" aria-labelledby="latest-notes-title">
      <div class="section-heading">
        <h2 id="latest-notes-title">Latest Writing</h2>
        <a href="/work/">view my work -&gt;</a>
      </div>
      {latestWriting.length > 0 ? (
        <ol class="note-list">
          {latestWriting.map((entry) => (
            <li>
              <a href={entry.href}>
                <time datetime={entry.date}>{entry.displayDate}</time>
                <span>{entry.title}</span>
                <small>{entry.tag}</small>
              </a>
            </li>
          ))}
        </ol>
      ) : null}
      <div class="writing-coming-soon">
        <span class="coming-soon-dot" aria-hidden="true"></span>
        <p>Writing is currently under construction. In the meantime, feel free to <a href="/work/">view my work &rarr;</a></p>
      </div>
    </section>
  </main>
</Layout>
