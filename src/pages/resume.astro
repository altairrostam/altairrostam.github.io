---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Resume" description="A web resume for Altair Rostam.">
  <section class="content-shell py-14 sm:py-20">
    <p class="metadata">Resume</p>
    <h1 class="mt-4 font-heading text-[clamp(3rem,8vw,6rem)] font-extrabold leading-none">Resume</h1>
    <p class="mt-6 max-w-prose text-lg leading-8 text-secondary">
      A structured resume page will be rendered from shared data in the next content pass. The PDF artifact remains a manual sync item for v1.
    </p>
    <a class="mt-8 inline-flex rounded-md bg-ocean px-5 py-3 font-mono text-sm text-bg no-underline" href="/resume.pdf" download>
      Download PDF
    </a>
  </section>
</BaseLayout>
