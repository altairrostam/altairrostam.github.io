---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Resume" description="A web resume for Altair Rostam.">
  <section class="content-shell pt-14 pb-10">
    <h1 class="font-heading text-xl font-semibold">Résumé</h1>
    <p class="mt-2 max-w-prose text-secondary">
      A structured page is coming. For now, the PDF is the source of truth.
    </p>
    <p class="mt-6">
      <a class="font-mono text-sm text-secondary no-underline hover:text-primary" href="/resume.pdf" download>
        Download PDF →
      </a>
    </p>
  </section>
</BaseLayout>
