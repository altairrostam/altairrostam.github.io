---
import Layout from "../layouts/Layout.astro";
import HeaderBand from "../components/HeaderBand.astro";
import PageTitle from "../components/PageTitle.astro";

const stack = [
  "Python", "TypeScript", "React", "Next.js", "FastAPI",
  "PostgreSQL", "AWS", "Terraform", "Docker", "Playwright", "PyTorch"
];
---

<Layout
  title="Resume — Altair R. | Senior Software Engineer"
  description="Resume of Altair R., Senior Software Engineer. Experience in full-stack systems, backend services, AI/ML pipelines, and cloud infrastructure."
  canonical="https://altairrostam.github.io/resume/"
>
  <HeaderBand active="resume" />

  <main class="content-main">
    <header class="page-header resume-header">
      <div class="resume-title-bar">
        <PageTitle title="Resume" icon="fortress" />
        <a
          class="resume-download-btn"
          href="/assets/files/Resume-Senior%20Software%20Engineer-Altair%20R.pdf"
          download="Resume-Senior Software Engineer-Altair R.pdf"
          aria-label="Download Resume as PDF"
        >
          <svg class="download-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download PDF</span>
        </a>
      </div>
    </header>

    <section class="resume-sheet" aria-label="Resume">
      <header class="resume-top">
        <div class="resume-top-content">
          <h1>Altair R.</h1>
          <p class="resume-role">Senior Software Engineer</p>
          <p class="resume-tagline">Full-Stack &amp; Backend Systems &middot; AI/ML &middot; Cloud Infrastructure &middot; Browser Automation</p>
          <p class="resume-bio">I build production systems across frontend, backend, data, automation, AI, and infrastructure. Currently Head of Engineering at UNIVERSA AI, where I progressed from Senior AI Engineer while remaining hands-on.</p>
        </div>
      </header>

      <section class="resume-block">
        <h2>Experience</h2>

        <article class="resume-item">
          <header class="resume-item-header">
            <h3 class="resume-company">UNIVERSA AI</h3>
            <p class="resume-company-desc">AI organization working on agent-based systems, applied AI, and experimental technology products.</p>
            <div class="resume-role-line">
              <strong>Head of Engineering</strong>
              <span class="resume-role-sep" aria-hidden="true">·</span>
              <span class="resume-dates">2024 &ndash; Present</span>
            </div>
            <p class="resume-role-subnote">Started as a Senior AI Engineer</p>
          </header>
          <div class="resume-item-body">
            <p>I work across full-stack systems, backend infrastructure, browser automation, AI workflows, and cloud infrastructure.</p>
            <p>I take defined workflows, figure out how they should work technically, and turn them into architecture and production systems &mdash; usually staying close enough to the code to help ship them.</p>
          </div>
        </article>

        <article class="resume-item">
          <header class="resume-item-header">
            <h3 class="resume-company">Aria Health</h3>
            <p class="resume-company-desc">Healthtech company building patient-controlled health-data platforms and clinical research tools.</p>
            <div class="resume-role-line">
              <strong>Senior Full-Stack Software Engineer</strong>
              <span class="resume-role-sep" aria-hidden="true">·</span>
              <span class="resume-dates">2023 &ndash; 2024</span>
            </div>
            <p class="resume-role-subnote">Engineer #3 on the founding team</p>
          </header>
          <div class="resume-item-body">
            <p>Built clinical software across frontend, backend, healthcare data pipelines, and integrations.</p>
            <p>Being part of a small founding team meant working across boundaries a lot &mdash; from UI and APIs to infrastructure and healthcare data.</p>
          </div>
        </article>

        <article class="resume-item">
          <header class="resume-item-header">
            <h3 class="resume-company">Cheeri</h3>
            <p class="resume-company-desc">Impact-tech platform for managing, measuring, and funding social-impact projects.</p>
            <div class="resume-role-line">
              <strong>Software Engineer</strong>
              <span class="resume-role-sep" aria-hidden="true">·</span>
              <span class="resume-dates">2022</span>
            </div>
          </header>
          <div class="resume-item-body">
            <p>Built web features and Google Drive&ndash;integrated file-management workflows.</p>
          </div>
        </article>

        <article class="resume-item">
          <header class="resume-item-header">
            <h3 class="resume-company">ITS Research Lab</h3>
            <p class="resume-company-desc">Applied AI R&D group building medical-imaging systems in collaboration with clinicians and hospitals.</p>
            <div class="resume-role-line">
              <strong>AI / Full-Stack Software Engineer</strong>
              <span class="resume-role-sep" aria-hidden="true">·</span>
              <span class="resume-dates">2019 &ndash; 2022</span>
            </div>
          </header>
          <div class="resume-item-body">
            <p>Built healthcare AI software for medical imaging, from research prototypes to systems deployed in hospital environments.</p>
            <p>I worked wherever the problem happened to be: frontend, backend, AI pipelines, medical-imaging infrastructure, deployment, or hospital integration.</p>
          </div>
        </article>
      </section>

      <section class="resume-block">
        <h2>Stack</h2>
        <p class="resume-stack-lead">I move around the stack depending on what the problem needs.</p>
        <p class="resume-skills-cloud">
          {stack.join(" · ")}
        </p>
      </section>

      <footer class="resume-note">
        <span>Detailed history and full portfolio available in the <a class="resume-note-download" href="/assets/files/Resume-Senior%20Software%20Engineer-Altair%20R.pdf" download="Resume-Senior Software Engineer-Altair R.pdf">downloadable PDF</a>.</span>
        <span>Updated 2026.09</span>
      </footer>
    </section>
  </main>
</Layout>
