---
import Layout from "../layouts/Layout.astro";
import HeaderBand from "../components/HeaderBand.astro";
import PageTitle from "../components/PageTitle.astro";

const stack = [
  "Python", "TypeScript", "JavaScript", "React", "Next.js", "Vue.js",
  "FastAPI", "Django", "PostgreSQL", "MongoDB", "Redis", "Kafka",
  "Elasticsearch", "AWS", "Terraform", "Docker", "CI/CD",
  "Browser Automation", "Web Crawling", "PyTorch", "TensorFlow",
  "Computer Vision", "LLM Systems"
];
---

<Layout
  title="Resume — Altair R. | Senior Software Engineer"
  description="Resume of Altair R., Senior Software Engineer. Experience in full-stack systems, backend services, AI/ML pipelines, and cloud infrastructure."
  canonical="https://altairrostam.github.io/resume/"
>
  <HeaderBand active="resume" />

  <main class="content-main">
    <header class="page-header resume-header">
      <div class="resume-title-bar">
        <PageTitle title="Resume" icon="fortress" />
        <a
          class="resume-download-btn"
          href="/assets/files/Resume-Senior%20Software%20Engineer-Altair%20R.pdf"
          download="Resume-Senior Software Engineer-Altair R.pdf"
          aria-label="Download Resume as PDF"
        >
          <svg class="download-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download PDF</span>
        </a>
      </div>
    </header>

    <section class="resume-sheet" aria-label="Resume">
      <header class="resume-top">
        <div class="resume-top-content">
          <h1>Altair R.</h1>
          <p class="resume-role">Senior Software Engineer</p>
          <p class="resume-tagline">Full-Stack &amp; Backend Systems &middot; AI/ML &middot; Cloud Infrastructure &middot; Browser Automation</p>
          <p class="resume-bio">I build production systems across frontend, backend, data, automation, AI, and infrastructure. Currently Head of Engineering at UNIVERSA AI, where I progressed from Senior AI Engineer while remaining hands-on.</p>
        </div>
      </header>

      <section class="resume-block">
        <h2>Experience</h2>

        <article class="resume-item">
          <header class="resume-item-header">
            <div class="resume-item-primary">
              <h3 class="resume-company">UNIVERSA AI</h3>
              <span class="resume-dates">2024 &ndash; Present</span>
            </div>
            <div class="resume-item-secondary">
              <span class="resume-role-title">Head of Engineering</span>
              <span class="resume-role-note">Previously Senior AI Engineer</span>
            </div>
          </header>
          <ul>
            <li>Built an automation platform that processed <strong>~250,000 records into ~4,500 qualified leads</strong>, reducing manual analysis by ~75%.</li>
            <li>Built full-stack products spanning frontend applications, backend APIs, data workflows, reporting, monitoring, payments, and production infrastructure.</li>
            <li>Developed persistent, proxy-backed browser automation for authenticated workflows, including human-like interaction and computer-vision-assisted CAPTCHA recognition.</li>
            <li>Co-built an internal AI agent framework using state-machine orchestration to coordinate parallel LLM-driven workflows with real-time execution visibility.</li>
            <li>Translate loosely defined business and research objectives into workflows, technical architecture, implementation plans, and production systems across engineering, AI, and infrastructure.</li>
          </ul>
        </article>

        <article class="resume-item">
          <header class="resume-item-header">
            <div class="resume-item-primary">
              <h3 class="resume-company">Aria Health / Dcentric Health Ltd</h3>
              <span class="resume-dates">2023 &ndash; 2024</span>
            </div>
            <div class="resume-item-secondary">
              <span class="resume-role-title">Senior Full-Stack Software Engineer</span>
              <span class="resume-role-note">Engineer #3 on founding team</span>
            </div>
          </header>
          <ul>
            <li>Built clinical software combining patient FHIR profiles with pharmaceutical data to identify potential medication contraindications.</li>
            <li>Developed backend services, data pipelines, authentication, caching, search, and asynchronous processing.</li>
            <li>Built <strong>50+ reusable React components</strong> and established a shared frontend component foundation.</li>
            <li>Worked across clinical, product, and data teams as engineering grew from 3 to 6.</li>
          </ul>
        </article>

        <article class="resume-item">
          <header class="resume-item-header">
            <div class="resume-item-primary">
              <h3 class="resume-company">Cheeri / Divao LLC</h3>
              <span class="resume-dates">2022</span>
            </div>
            <div class="resume-item-secondary">
              <span class="resume-role-title">Software Engineer</span>
            </div>
          </header>
          <ul>
            <li>Built Google Drive file-management workflows and reusable Vue.js frontend components.</li>
          </ul>
        </article>

        <article class="resume-item">
          <header class="resume-item-header">
            <div class="resume-item-primary">
              <h3 class="resume-company">ITS Research Lab</h3>
              <span class="resume-dates">2019 &ndash; 2022</span>
            </div>
            <div class="resume-item-secondary">
              <span class="resume-role-title">AI / Full-Stack Software Engineer</span>
            </div>
          </header>
          <ul>
            <li>Built and deployed three healthcare AI systems spanning brain MRI, lung imaging, and dermatology.</li>
            <li>Developed full-stack applications, backend APIs, AI inference pipelines, and cloud infrastructure from requirements through hospital deployment.</li>
            <li>Processed <strong>10,000+ medical-imaging records</strong> and built DICOM/NIfTI ingestion, PACS integration, and medical-image viewing infrastructure.</li>
            <li>Worked with researchers, clinicians, and hospitals to translate domain requirements into production software.</li>
          </ul>
        </article>
      </section>

      <section class="resume-block">
        <h2>Stack</h2>
        <p class="resume-skills-cloud">
          {stack.join(" · ")}
        </p>
      </section>

      <footer class="resume-note">
        <span>Detailed history and full portfolio available in the <a class="resume-note-download" href="/assets/files/Resume-Senior%20Software%20Engineer-Altair%20R.pdf" download="Resume-Senior Software Engineer-Altair R.pdf">downloadable PDF</a>.</span>
        <span>Updated 2026.09</span>
      </footer>
    </section>
  </main>
</Layout>
