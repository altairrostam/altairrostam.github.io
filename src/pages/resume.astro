---
import Layout from "../layouts/Layout.astro";
import HeaderBand from "../components/HeaderBand.astro";
---

<Layout title="Resume | Altair R." description="Resume for Altair R., software engineer.">
  <HeaderBand active="resume" />

  <main class="content-main">
    <a class="back-link" href="/assets/files/resume.pdf">download pdf</a>
    <section class="resume-sheet" aria-label="Resume">
      <header class="resume-top">
        <div>
          <h1>Altair R.</h1>
          <p>Software engineer, roamer by role - I work on whatever is actually broken.</p>
        </div>
        <div class="resume-contact">
          <div>altairrostam@gmail.com</div>
          <div>github.com/altairrostam</div>
          <div>linkedin.com/in/altair-r</div>
        </div>
      </header>

      <section class="resume-block">
        <h2>Experience</h2>
        <article class="resume-item">
          <h3>Staff Engineer <span>Ferrovia</span> <time>2024 - now</time></h3>
          <ul>
            <li>Joined to fix one payments reconciliation job; ended up owning the three systems it touched.</li>
            <li>Reduced incident volume on the settlement pipeline by rebuilding its retry semantics, not by adding more alerting.</li>
          </ul>
        </article>
        <article class="resume-item">
          <h3>Senior Engineer <span>Loom &amp; Wire</span> <time>2021 - 2024</time></h3>
          <ul>
            <li>Rewrote the inventory sync service after the third time it silently double-counted stock.</li>
            <li>Ran the migration off the vendor search index nobody else wanted to touch.</li>
          </ul>
        </article>
        <article class="resume-item">
          <h3>Software Engineer <span>Basin Health</span> <time>2018 - 2021</time></h3>
          <ul>
            <li>Built the clinic scheduling backend from a spreadsheet and a promise.</li>
            <li>Spent a year on HIPAA-adjacent plumbing nobody else wanted to own.</li>
          </ul>
        </article>
        <article class="resume-item">
          <h3>Software Engineer <span>Kettlebell Labs</span> <time>2015 - 2018</time></h3>
          <ul>
            <li>First real engineering job; shipped the checkout flow that's still in production.</li>
            <li>Learned what "done" means from an on-call rotation of one.</li>
          </ul>
        </article>
      </section>

      <div class="resume-grid">
        <section class="resume-block">
          <h2>Projects</h2>
          <article class="resume-item">
            <h3>runbook <small>go</small></h3>
            <p>Static-site generator for on-call docs; fails the build on a stale link.</p>
          </article>
          <article class="resume-item">
            <h3>quietpager <small>typescript</small></h3>
            <p>Pager-duty analytics surfacing which services are actually loud.</p>
          </article>
          <article class="resume-item">
            <h3>backfill <small>rust</small></h3>
            <p>CLI for replaying production traffic against staging without melting it.</p>
          </article>
        </section>

        <section class="resume-block">
          <h2>Open Source</h2>
          <article class="resume-item">
            <h3>postgres-lag-exporter <small>maintainer</small></h3>
            <p>Small metrics exporter for replication lag.</p>
          </article>
          <article class="resume-item">
            <h3>sidekiq <small>contributor</small></h3>
            <p>A few merged fixes around dead job retries.</p>
          </article>
          <article class="resume-item">
            <h3>httpx <small>contributor</small></h3>
            <p>Fixed a timeout edge case that took longer to reproduce than to fix.</p>
          </article>
        </section>
      </div>

      <footer class="resume-note">
        <span>Full history and writing at the site this resume links from.</span>
        <span>Updated 2026.08</span>
      </footer>
    </section>
  </main>
</Layout>
