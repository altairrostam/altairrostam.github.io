---
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.dateUpdated.valueOf() - a.data.dateUpdated.valueOf(),
);
---

<BaseLayout title="Projects" description="Documented project work, architecture notes, tradeoffs, and lessons learned.">
  <section class="content-shell pt-14 pb-10">
    <h1 class="font-heading text-xl font-semibold">Projects</h1>
    <p class="mt-2 max-w-prose text-secondary">
      Architecture notes, implementation tradeoffs, and lessons from systems that had to survive contact with real constraints.
    </p>
  </section>
  <section class="content-shell pb-14">
    <div>
      {projects.map((project) => <ProjectCard entry={project} />)}
    </div>
  </section>
</BaseLayout>
