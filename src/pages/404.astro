---
import Layout from "../layouts/Layout.astro";
import HeaderBand from "../components/HeaderBand.astro";
---

<Layout
  title="404: Page Not Found — Altair R."
  description="The requested page could not be found."
  noindex={true}
>
  <Fragment slot="head">
    <script is:inline>
      (function() {
        var path = window.location.pathname;
        if (path === '/projects' || path === '/projects/' || path === '/projects.html') {
          window.location.replace('/work/');
        } else if (path.endsWith('.html')) {
          var clean = path.replace(/\.html$/, '/');
          window.location.replace(clean);
        }
      })();
    </script>
  </Fragment>
  <HeaderBand />

  <main class="content-main">
    <header class="page-header">
      <h1>404</h1>
      <p>This page wandered off. The useful paths are still nearby.</p>
    </header>

    <nav class="error-links" aria-label="404 navigation">
      <a href="/">home</a>
      <a href="/writing/">writing</a>
      <a href="/work/">work</a>
      <a href="/about/">about</a>
    </nav>
  </main>
</Layout>
