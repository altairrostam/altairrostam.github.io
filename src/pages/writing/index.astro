---
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/writing/ArticleCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const articles = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const tags = Array.from(new Set(articles.flatMap((article) => article.data.tags))).sort();
---

<BaseLayout title="Writing" description="Long-form technical writing on AI systems, retrieval, automation, and engineering tradeoffs.">
  <section class="content-shell py-14 sm:py-20">
    <p class="metadata">Research journal</p>
    <h1 class="mt-4 font-heading text-[clamp(3rem,8vw,6rem)] font-extrabold leading-none">Writing</h1>
    <p class="mt-6 max-w-prose text-lg leading-8 text-secondary">
      Notes for readers who want architecture, tradeoffs, and what changed after the demo worked.
    </p>
    <div class="mt-8 flex flex-wrap gap-2" aria-label="Available tags">
      {
        tags.map((tag) => (
          <a class="rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-xs text-nature no-underline hover:border-ocean" href={`/writing?tag=${tag}`}>
            {tag}
          </a>
        ))
      }
    </div>
    <div class="mt-10">
      {articles.map((article) => <ArticleCard entry={article} />)}
    </div>
  </section>
</BaseLayout>
