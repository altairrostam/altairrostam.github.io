---
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/writing/ArticleCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const articles = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const tags = Array.from(new Set(articles.flatMap((article) => article.data.tags))).sort();
---

<BaseLayout title="Writing" description="Long-form technical writing on AI systems, retrieval, automation, and engineering tradeoffs.">
  <section class="content-shell pt-14 pb-10">
    <h1 class="font-heading text-xl font-semibold">Writing</h1>
    <p class="mt-2 max-w-prose text-secondary">
      Notes on AI systems — architecture, tradeoffs, and what changed after the demo worked.
    </p>
    <div class="mt-6 flex flex-wrap gap-2" aria-label="Available tags">
      {
        tags.map((tag) => (
          <a class="font-mono text-xs text-secondary no-underline opacity-60 hover:opacity-100" href={`/writing?tag=${tag}`}>
            #{tag}
          </a>
        ))
      }
    </div>
  </section>
  <section class="content-shell pb-14">
    <div data-stagger>
      {articles.map((article) => <ArticleCard entry={article} />)}
    </div>
  </section>
</BaseLayout>
