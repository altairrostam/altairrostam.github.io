---
import Layout from "../layouts/Layout.astro";
import HeaderBand from "../components/HeaderBand.astro";
import PageTitle from "../components/PageTitle.astro";
import { writingEntries } from "../data/content";

const tags = [...new Set(writingEntries.map((entry) => entry.tag))];
---

<Layout
  title="Writing — Altair R. | Software Engineer"
  description="Essays, technical notes, and engineering observations by Altair R. on systems, software architecture, and AI."
  canonical="https://altairrostam.github.io/writing/"
>
  <HeaderBand active="writing" />

  <main class="content-main">
    <header class="page-header">
      <PageTitle title="Writing" icon="quill" />
      <p>Essays, notes, and working observations in one stream. Some are argued out fully; some are just useful enough to keep.</p>
    </header>

    {tags.length > 0 ? (
      <div class="tag-filter" aria-label="Filter writing by tag">
        {tags.map((tag) => <button type="button" data-filter-tag={tag}>{tag}</button>)}
      </div>
    ) : null}

    <section aria-label="Writing archive">
      {writingEntries.length > 0 ? (
        <ol class="note-list archive-list">
          {writingEntries.map((entry) => (
            <li data-note-tag={entry.tag}>
              <a href={entry.href}>
                <time datetime={entry.date}>{entry.displayDate}</time>
                <span>
                  <strong>{entry.title}</strong>
                  <em>{entry.summary}</em>
                </span>
                <small>{entry.type} / {entry.tag}</small>
              </a>
            </li>
          ))}
        </ol>
      ) : null}

      <div class="writing-coming-soon is-empty-state">
        <span class="coming-soon-dot" aria-hidden="true"></span>
        <p>This section is currently under construction. In the meantime, feel free to <a href="/work/">view my work &rarr;</a></p>
      </div>
    </section>
  </main>
</Layout>
